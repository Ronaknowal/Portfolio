   "source": [
    "# Offset-adjusted measurements\n",
    "One row is one measurement; units are milliseconds."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2cae9cf4",
   "metadata": {},
   "outputs": [],
   "source": [
    "values = [10, 20, 30]\n",
    "offset = 2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "caf4f8f9",
   "metadata": {},
   "outputs": [],
   "source": [
    "adjusted = [x - offset for x in values]\n",
    "mean = sum(adjusted) / len(adjusted)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "351071b1",
   "metadata": {},
   "outputs": [],
   "source": [
    "assert len(adjusted) == 3\n",
    "assert mean == 18.0\n",
    "print(mean)"
   ]
  }
 ],
 "metadata": {},
 "nbformat": 4,
 "nbformat_minor": 5
}

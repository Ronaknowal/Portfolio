              {
                "width": 760,
                "content": 760,
                "tex": "\\begin{gathered}X_t=x_0+\\mu t+\\sigma W_t,\\\\\\Delta X=\\mu\\Delta t+\\sigma\\sqrt{\\Delta t}\\,Z,\\\\Z\\sim N(0,1),\\\\E[X_t]=x_0+\\mu t,\\\\\\operatorname{Var}(X_t)=\\sigma^2t.\\end{gathered}"
              },
              {
                "width": 760,
                "content": 760,
                "tex": "\\operatorname{Cov}(X_s,X_t)=\\sigma^2\\min(s,t)."
